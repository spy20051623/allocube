NODE_ENV=production
# 所有 <UPPER_SNAKE_CASE> 均为必须替换的占位符，尖括号不能保留。
APP_DOMAIN=<ALLOCUBE_DOMAIN>

# 以下项目仅在全新数据库首次启动时读取，之后以系统内保存的配置为准。
# 未填写时会采用系统默认值，管理员登录后可以继续配置。
# 首次生产部署应显式设置一个不与仓库示例相同的管理员强密码。
# BOOTSTRAP_ADMIN_NAME=系统管理员
# BOOTSTRAP_ADMIN_PASSWORD='<ADMIN_PASSWORD>'
# 支持 http:// 或 https://，应与用户实际访问地址一致。
# BOOTSTRAP_SITE_ORIGIN=<BASE_URL>
# BOOTSTRAP_ALLOWED_EMAIL_DOMAINS=<ALLOWED_EMAIL_DOMAINS>
# BOOTSTRAP_MIN_BOOKING_MINUTES=1
# BOOTSTRAP_MAX_BOOKING_MINUTES=1440
# BOOTSTRAP_ADVANCE_DAYS=30
# BOOTSTRAP_SMTP_ENABLED=false
# BOOTSTRAP_SMTP_HOST=<SMTP_HOST>
# BOOTSTRAP_SMTP_PORT=465
# BOOTSTRAP_SMTP_SECURITY=IMPLICIT_TLS
# BOOTSTRAP_SMTP_USERNAME=<SMTP_USERNAME>
# BOOTSTRAP_SMTP_PASSWORD='<SMTP_PASSWORD>'
# BOOTSTRAP_SMTP_FROM_NAME=Allocube
# BOOTSTRAP_SMTP_FROM_ADDRESS=<SMTP_FROM_ADDRESS>

# 备份服务的可选部署参数。
# BACKUP_RETENTION_DAYS=14
# BACKUP_INTERVAL_SECONDS=86400
