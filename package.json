{
  "name": "allocube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:production-http": "node scripts/test-production-http.mjs",
    "test:realtime-http": "node scripts/test-realtime-http.mjs",
    "test:settings-network": "node scripts/test-settings-network.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "backup": "node scripts/backup.mjs",
    "db:reset": "node scripts/reset-db.mjs",
    "admin:reset-password": "node scripts/reset-admin-password.mjs",
    "test:calendar-adjustment": "node scripts/test-calendar-adjustment.mjs",
    "test:calendar-boundaries": "node scripts/test-calendar-boundaries.mjs",
    "test:edit-conflicts": "node scripts/test-edit-conflicts.mjs",
    "test:docs-loading": "node scripts/test-docs-loading.mjs",
    "test:browser-cache": "node scripts/test-browser-cache.mjs",
    "test:audit-http": "node scripts/test-audit-http.mjs",
    "test:theme": "node scripts/test-theme.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-router": "^1.170.18",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.10.0",
    "i18next": "26.4.0",
    "lucide-react": "^1.26.0",
    "nodemailer": "^9.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.12",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
